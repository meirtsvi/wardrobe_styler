# Copy to backend/.env (git-ignored). The only secrets in the system.
GEMINI_API_KEY=
# Any long random string; the app sends it as Authorization: Bearer <token>. Generate: openssl rand -hex 32
GATEWAY_TOKEN=
# Stop calling Gemini once today's estimated spend passes this (USD). Estimates use shared/config/price_table.v1.json.
DAILY_BUDGET_USD=5
PORT=8787
# Model ids (defaults in src/config.ts). Run `npm run probe-models` with the key set to see what the key can use.
# GEMINI_PLAN_MODEL=gemini-3.8-flash
# GEMINI_ATTRIBUTES_MODEL=gemini-3.5-flash-lite
# GEMINI_ATTRIBUTES_ACCURATE_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_LITE_MODEL=gemini-3.1-flash-lite-image
